// Open Frontier: ED's LocalDarkNebulaDust as cards (spec §6b).
//
// One indirect draw of camera-facing, alpha-blended dust cards sitting in
// the galactic plane - ED's cheap-cloud mechanism and the layer that makes
// close-up dust read as cloud rather than as a flat band. ED samples
// pLocalNebulaTexture (silhouette) + pNoiseMapTexture (structure); the
// silhouette texture's bytes were never carved (findings §7.9), so both the
// silhouette and the structure come from the shared 256^2 tiling value-noise
// texture generated by GalaxyDustCards. Three octaves at different scales
// give the irregular edge; a noise-warped radial mask keeps the card square
// out of the silhouette, and the old hard circle is gone.
//
// The counts and strength come from the quality ladder's
// localDustCards / localDustBrightness - ED's LocalDustBrightness
// (0.13 / 0.033 / 0.0) is a compensation knob that falls to exactly zero
// as the real nebula volumes rise, so at Hero this layer draws nothing.
//
// Billboard orientation happens in clip space against the per-camera
// projection matrix (the OpenFrontier_GalaxyCloud pattern), so one draw is
// correct in the ortho map view and the perspective in-sky view. Alpha
// blended (additive cannot darken), no depth write. Queue offset (2979)
// lives on the MATERIAL; the tag stays a defined name.
Shader "OpenFrontier/Galaxy/DustCard" {
	Properties {
		_NoiseMap ("Noise Map", 2D) = "black" {}
		_DustColour ("Dust Colour", Color) = (0.05,0.04,0.035,1)
		_NoiseScale ("Noise Tiling Per Card", Float) = 2.2
		_CardStrength ("Card Strength", Range(0,1)) = 0.13
	}
	SubShader {
		Tags { "Queue"="Transparent" "IgnoreProjector"="True" "RenderType"="Transparent" "PreviewType"="Plane" }
		Blend SrcAlpha OneMinusSrcAlpha
		Cull Off
		ZWrite Off
		ZTest LEqual

		Pass {
			HLSLPROGRAM
			#pragma target 4.5
			#pragma exclude_renderers gles
			#pragma vertex vert
			#pragma fragment frag
			#include "UnityCG.cginc"

			struct CardData
			{
				float4 posSize;  // xyz = galaxy-local position, w = card size (world units)
				float4 color;    // rgb = tint, a = peak alpha
				float4 rotSeed;  // x = rotation (rad), y = noise offset seed, z/w spare
			};

			StructuredBuffer<CardData> _InstanceData;
			float4x4 _LocalToWorld;
			sampler2D _NoiseMap;
			float _NoiseScale;
			float _CardStrength;
			fixed4 _DustColour;

			struct appdata_card
			{
				float4 vertex : POSITION;
				float2 uv : TEXCOORD0;
			};

			struct v2f_card
			{
				float4 pos : SV_POSITION;
				float2 uv : TEXCOORD0;                  // -1..1 across the card
				nointerpolation float4 rotSeed : TEXCOORD1;
				fixed4 color : COLOR0;
			};

			v2f_card vert(appdata_card v, uint id : SV_InstanceID)
			{
				v2f_card o;
				CardData d = _InstanceData[id];
				float3 world = mul(_LocalToWorld, float4(d.posSize.xyz, 1.0)).xyz;
				float4 clipPos = mul(UNITY_MATRIX_VP, float4(world, 1.0));
				// clip-space billboard (GalaxyCloud pattern): constant world
				// size under the ortho map, perspective-correct in the sky;
				// cards behind the camera collapse instead of flipping.
				float scale = clipPos.w > 0.0 ? 1.0 : 0.0;
				clipPos.xy += v.vertex.xy * d.posSize.w * scale
					* float2(UNITY_MATRIX_P._m00, UNITY_MATRIX_P._m11);
				o.pos = clipPos;
				o.uv = v.uv * 2.0 - 1.0;
				o.rotSeed = d.rotSeed;
				o.color = d.color;
				return o;
			}

			fixed4 frag(v2f_card i) : SV_Target
			{
				// rotate the noise lookup per card; the radial mask is also
				// noise-warped, so no card can read as a circle
				float s, c;
				sincos(i.rotSeed.x, s, c);
				float2 ruv = float2(i.uv.x * c - i.uv.y * s, i.uv.x * s + i.uv.y * c);

				float seed = i.rotSeed.y;
				float n1 = tex2D(_NoiseMap, ruv * _NoiseScale + seed).r;
				float n2 = tex2D(_NoiseMap, ruv * _NoiseScale * 2.31 + seed * 0.63 + 0.37).r;
				float n3 = tex2D(_NoiseMap, ruv * _NoiseScale * 5.17 - seed * 0.41).r;
				float n = saturate(n1 * 0.55 + n2 * 0.30 + n3 * 0.15);

				// irregular silhouette: a broad radial falloff whose radius is
				// displaced by the low-frequency noise
				float r = length(i.uv) * (0.80 + 0.35 * n1) + (n2 - 0.5) * 0.18;
				float sil = 1.0 - smoothstep(0.52, 1.0, r);
				float square = 1.0 - smoothstep(0.88, 1.0, max(abs(i.uv.x), abs(i.uv.y)));
				float cloud = smoothstep(0.34, 0.72, n);

				float a = saturate(sil * square * cloud * i.color.a * _CardStrength * 2.1);
				float3 col = _DustColour.rgb * (1.0 - n * 0.28);
				return fixed4(col, a);
			}
			ENDHLSL
		}
	}
}
