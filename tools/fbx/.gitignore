# Generated FBX fixtures and build output. run.sh recreates both.
out/
bin/
obj/
.build.log

# The root .gitignore excludes *.csproj, which is right for the harness's
# GENERATED projects (tools/harness/build/) but would also swallow this one,
# which is hand-written and source. The deepest .gitignore wins, so
# negating it here is enough.
!*.csproj